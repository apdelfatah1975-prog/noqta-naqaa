# Required for standalone deployment
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE?ssl=%7B%22rejectUnauthorized%22%3Atrue%7D
JWT_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=production

# Optional S3-compatible storage for uploaded proofs/images
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional Google Maps configuration, if enabled by the deployment
GOOGLE_MAPS_API_KEY=
